{
  "name": "pos-gihon",
  "version": "1.0.0",
  "description": "POS-GIHON - Point of Sale and Inventory Management System",
  "main": "main.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64",
    "build": "electron-builder"
  },
  "keywords": [
    "inventory",
    "pos",
    "postgresql",
    "barcode",
    "electron"
  ],
  "author": "GIHON",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.gihon.pos",
    "productName": "POS-GIHON",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!.gitignore",
      "!README.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "POS-GIHON.exe"
    }
  }
}